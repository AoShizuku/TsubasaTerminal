{
  "name": "tsubasaterminal",
  "productName": "Tsubasa Terminal",
  "version": "1.1.0",
  "description": "Tsubasa Terminal — AI-assisted SSH client with a hard command gate and human approval",
  "main": "./out/main/index.js",
  "author": "AoShizuku",
  "license": "MIT",
  "homepage": "https://github.com/AoShizuku/TsubasaTerminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/AoShizuku/TsubasaTerminal.git"
  },
  "bugs": {
    "url": "https://github.com/AoShizuku/TsubasaTerminal/issues"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-cli.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json --composite false",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:notices": "node scripts/gen-notices.mjs --check",
    "gen:notices": "node scripts/gen-notices.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test && npm run check:cycles && npm run check:notices",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:component": "vitest run tests/component",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs full",
    "test:e2e:nobuild": "node scripts/run-e2e.mjs full",
    "test:e2e:daily": "npm run build && node scripts/run-e2e.mjs daily",
    "test:e2e:daily:nobuild": "node scripts/run-e2e.mjs daily",
    "test:smoke": "npm run build && playwright test --config=playwright.smoke.config.ts",
    "test:smoke:nobuild": "playwright test --config=playwright.smoke.config.ts",
    "build:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.3.0",
    "openai": "^6.46.0",
    "reka-ui": "^2.10.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "trzsz": "^1.1.6",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@withfig/autocomplete": "^2.692.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.6"
  }
}
