{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "vitest.config.ts",
    "tests/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/preload/index.d.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
